# Plantilla de variables de entorno. Copiar a .env y completar.

# Base de datos. Local: Postgres de docker-compose. Producción: URL de Neon.
DATABASE_URL="postgresql://proges:proges@localhost:5432/proges?schema=public"

# Clerk (auth). Llaves desde dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
