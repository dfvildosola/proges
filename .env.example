# Copia este archivo a .env.local (Clerk) y .env (base de datos) y completa los valores.

# --- Base de datos (Postgres) ---
# Local con Docker (ver docker-compose.yml):
DATABASE_URL="postgresql://proges:proges_dev@localhost:5432/proges"

# --- Clerk (auth + organizaciones) ---
# Obtén estas llaves en https://dashboard.clerk.com -> tu app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
